{
  "name": "google-tasks-ha-add-on",
  "version": "0.0.0",
  "description": "Home assistant custom add-on to add functionalities to Google Tasks",
  "main": "index.js",
  "author": "Bruno Piaggio <brunopiaggiok@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "22.13.1"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --ignore-path .gitignore --check \"./src/**/*.+(js|ts|json)\"",
    "prettier:fix": "prettier --write src"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "exec": "tsc && node ./dist/app.js",
    "ext": "ts,js,json"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "googleapis": "^148.0.0"
  }
}
